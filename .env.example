# Copie para .env.local e preencha. Nada aqui é segredo de verdade: são só os nomes.

# Senha do modo LEGADO do painel. Só vale enquanto ADMIN_SESSION_SECRET e
# ADMIN_PASSWORD_PEPPER não estiverem definidos (ver lib/admin-auth.ts).
ADMIN_PASSWORD=troque-esta-senha

# Modo novo do painel (contas em admin_users): segredo da sessão e pepper das senhas.
# Gere valores longos e aleatórios, diferentes um do outro.
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD_PEPPER=
# Sal do hash de IP das tentativas de login (opcional: sem ele, usa ADMIN_SESSION_SECRET;
# deixe a linha comentada em vez de vazia — vazia vale como sal vazio).
# LOGIN_IP_PEPPER=

# local | supabase. Deixe VAZIO: com as chaves do Supabase definidas, usa o Supabase.
# "local" (o arquivo leagueofbronze.json do repositório) é SÓ para desenvolvimento —
# num deploy de produção ele serve a temporada antiga do repositório como se estivesse no ar.
DATA_PROVIDER=

# Supabase (obrigatório em produção e no site de teste)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATASET_ROW_ID=leagueofbronze
# Schema do banco. Vazio = "public" (produção). O site de teste usa lob_teste.
SUPABASE_DB_SCHEMA=

# Segredo do robô diário (/api/cron/riot). Só em produção.
CRON_SECRET=

# Riot API (opcional: importar jogo automaticamente pelo match ID no admin)
RIOT_API_KEY=
# Plataforma padrão para quando informar só o número do jogo (ex.: BR1_123...)
RIOT_DEFAULT_PLATFORM=BR1
